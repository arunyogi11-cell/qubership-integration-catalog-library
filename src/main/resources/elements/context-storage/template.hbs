<setProperty name="internalProperty_sessionContext_useCorrelationId">
    <constant>{{property 'useCorrelationId'}}</constant>
</setProperty>
<setProperty name="internalProperty_sessionContext_context">
    <constant>{{property 'context'}}</constant>
</setProperty>
<setProperty name="internalProperty_sessionContext_sessionId">
    <simple>{{escape (property 'sessionId')}}</simple>
</setProperty>
<setProperty name="internalProperty_sessionContext_operation">
    <constant>{{property 'operation'}}</constant>
</setProperty>
<setProperty name="internalProperty_sessionContext_key">
    <simple>{{escape (property 'key')}}</simple>
</setProperty>
<setProperty name="internalProperty_sessionContext_value">
    <simple>{{escape (property 'value')}}</simple>
</setProperty>
<setProperty name="internalProperty_sessionContext_ttl">
    <simple>{{property 'ttl'}}</simple>
</setProperty>
<setProperty name="internalProperty_sessionContext_keys">
    <simple>{{escape (property 'keys')}}</simple>
</setProperty>
<setProperty name="internalProperty_sessionContext_target">
    <constant>{{property 'target'}}</constant>
</setProperty>
<setProperty name="internalProperty_sessionContext_targetName">
    <simple>{{escape (property 'targetName')}}</simple>
</setProperty>
<setProperty name="internalProperty_sessionContext_unwrap">
    <constant>{{property 'unwrap'}}</constant>
</setProperty>
<setProperty name="internalProperty_sessionContext_connectTimeout">
    <constant>{{property 'connectTimeout'}}</constant>
</setProperty>
<doTry>
    {{#if-property 'propagateContext' equals='true'}}
        {{#if-property 'overrideContextParams' presented=''}}
            <setProperty name="internalProperty_overrideContextParams">
                <simple>{{escape (property-json 'overrideContextParams')}}</simple>
            </setProperty>
        {{/if-property}}

        <process ref="contextPropagationProcessor"/>
    {{/if-property}}

    <process id="{{identifier}}" ref="contextStorageProcessor"/>

    <process ref="contextRestoreProcessor"/>
    <doFinally>
        <removeProperty name="internalProperty_sessionContext_useCorrelationId"/>
        <removeProperty name="internalProperty_sessionContext_sessionId"/>
        <removeProperty name="internalProperty_sessionContext_operation"/>
        <removeProperty name="internalProperty_sessionContext_key"/>
        <removeProperty name="internalProperty_sessionContext_value"/>
        <removeProperty name="internalProperty_sessionContext_ttl"/>
        <removeProperty name="internalProperty_sessionContext_keys"/>
        <removeProperty name="internalProperty_sessionContext_target"/>
        <removeProperty name="internalProperty_sessionContext_targetName"/>
        <removeProperty name="internalProperty_sessionContext_unwrap"/>
        <removeProperty name="internalProperty_sessionContext_connectTimeout"/>

        <removeProperty name="internalProperty_overrideContextParams"/>
        <process ref="contextRestoreProcessor"/>
    </doFinally>
</doTry>

